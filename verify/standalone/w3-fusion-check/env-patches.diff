diff --git a/flowlog-compiler/src/scaffold.rs b/flowlog-compiler/src/scaffold.rs
index c25fcd1..d7a0adb 100644
--- a/flowlog-compiler/src/scaffold.rs
+++ b/flowlog-compiler/src/scaffold.rs
@@ -167,6 +167,15 @@ pub(crate) fn render_cargo_toml(config: &Config, features: &Features) -> String
     if !rendered.ends_with('\n') {
         rendered.push('\n');
     }
+    // Build *this* generated crate at opt-level 1 (its ~29k-line function makes
+    // opt-level 3 LLVM compiles intractable for large DOOP programs) while
+    // leaving dependencies (timely / differential-dataflow) at the default
+    // release opt-level 3 for full runtime speed. Env knob for the benchmark;
+    // identical for base + w3, so the planner fusion stays the only variable.
+    rendered.push_str(&format!(
+        "\n[profile.release]\nopt-level = 3\n\n[profile.release.package.\"{}\"]\nopt-level = 1\n",
+        config.crate_name()
+    ));
     rendered
 }
 
